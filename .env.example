# ============================================
# Environment Variables for Nuno AI
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Mailgun Email Configuration (for Vercel)
# ============================================
# IMPORTANT: Get your PRIVATE API KEY from https://app.mailgun.com/settings/api_security
# Do NOT use your SMTP password - use the actual API key that starts with "privkey-"
# Example: privkey-3123456789abcdef3123456789abcdef3123456789abcdef3123456789abcdef
MAILGUN_API_KEY=your-private-api-key-from-mailgun-dashboard
# Your verified Mailgun domain
MAILGUN_DOMAIN=noreply.rapidactivemarketing.com
# From address for outgoing emails (use simple format: email@domain.com)
# Note: Must be verified in Mailgun at https://app.mailgun.com/settings/authorized_senders
MAILGUN_FROM=nunoai@noreply.rapidactivemarketing.com

# ============================================
# Application URLs
# ============================================
# Public URL used in email confirmation links
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# Supabase Configuration
# ============================================
# Public (browser-side) - Safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key (server-side) - Required for admin operations (password reset, etc.)
# Get from: https://supabase.com/dashboard → Settings → API → service_role key
# NEVER expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Optional: YouTube Brain API (if using)
# ============================================
YBR_API_URL=https://your-api.vercel.app
YBR_SUPABASE_URL=https://your-project.supabase.co
YBR_SUPABASE_ANON_KEY=your-anon-key-here
YBR_EMAIL=your-email@example.com
YBR_PASSWORD=your-password-here

# ============================================
# Optional: YouTube Data API (for playlist/channel sync)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key

# ============================================
# Optional: Supadata API (reliable YouTube transcript service)
# ============================================
# Get from: https://supadata.ai
SUPADATA_API_KEY=your-supadata-api-key
